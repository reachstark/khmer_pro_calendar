# Vercel Web Analytics REST API configuration (set these in Vercel Project Settings -> Environment Variables)
# Docs: https://vercel.com/docs/analytics/query-api
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Optional: include ONLY for Vercel Team projects (omit both for personal account projects)
# VERCEL_TEAM_ID=team_1234567890
# VERCEL_TEAM_SLUG=your_team_slug

# Optional: OData filter expression (e.g. requestPath eq '/')
# VERCEL_ANALYTICS_FILTER=requestPath eq '/'
